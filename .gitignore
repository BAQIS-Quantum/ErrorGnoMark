# ===================================================================
# ErrorGnoMark - Official .gitignore
# ===================================================================


# ===================================================================
# 1. Python Generated Files
# ===================================================================

__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST


# ===================================================================
# 2. Virtual Environments
# ===================================================================

.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/


# ===================================================================
# 3. IDE / Editor
# ===================================================================

# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# PyCharm
.idea/

# Sublime
*.sublime-project
*.sublime-workspace


# ===================================================================
# 4. Testing & Coverage
# ===================================================================

.pytest_cache/
.tox/

.coverage
.coverage.*
coverage.xml
htmlcov/


# ===================================================================
# 5. Large Data / Experiment Outputs
# ===================================================================
# Git is NOT for large datasets. Use Git LFS if necessary.

*.csv
*.pkl
*.h5
*.hdf5
*.dat
*.log
*.tmp

figures/
plots/


# ===================================================================
# 6. Secrets / Environment Variables
# ===================================================================

*.env
secrets.ini
config.ini


# ===================================================================
# 7. OS Files
# ===================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini


# ===================================================================
# 8. Personal / AI Workspace (DO NOT PUSH)
# ===================================================================

.egm-ai/
ai_logs/
notes-private/
claude_logged.sh

# Internal tools / generated artifacts (forward-fix for public repo)
dev_claude/
reports/
tmp/
scripts/log_ai_session.py

# Internal documents (team reports, presentations)
docs/internal/

# Secrets that may appear in root (CRITICAL: never commit)
c


# ===================================================================
# 9. Tool Caches
# ===================================================================

.ruff_cache/